<!DOCTYPE html>
<html lang="uk">
  <head>
    <title><%= content_for(:title) || "Безбар'єрний Івано-Франківськ" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand fw-bold d-flex align-items-center gap-2" do %>
          <i class="bi bi-universal-access-circle fs-4"></i>
          <span>BarrierFree IF</span>
        <% end %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <%= link_to "Усі локації", places_path, class: "nav-link #{current_page?(places_path) || current_page?(root_path) ? 'active fw-semibold' : ''}" %>
            </li>
            <li class="nav-item">
              <%= link_to "Повністю доступні", accessible_places_path, class: "nav-link #{current_page?(accessible_places_path) ? 'active fw-semibold' : ''}" %>
            </li>
            <li class="nav-item">
              <%= link_to "Райони Івано-Франківська", districts_path, class: "nav-link #{controller_name == 'districts' ? 'active fw-semibold' : ''}" %>
            </li>
          </ul>

          <%= link_to new_place_path, class: "btn btn-light text-primary fw-semibold" do %>
            <i class="bi bi-plus-circle me-1"></i> Додати локацію
          <% end %>
        </div>
      </div>
    </nav>

    <main class="container my-4 flex-grow-1">
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i><%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i><%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="bg-white border-top py-3 mt-auto text-muted small">
      <div class="container d-flex justify-content-between">
        <span>Моніторинг безбар’єрності міського простору м. Івано-Франківськ</span>
        <span>Ruby on Rails &bull; Bootstrap 5</span>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>