<div class="mb-3">
  <%= link_to "← Усі райони", districts_path, class: "text-decoration-none" %>
</div>
<h1 class="h3 mb-1">Район: <%= @district.name %></h1>
<p class="text-muted mb-4">Рівень безпеки маршрутів: <strong><%= @district.route_safety_level %></strong></p>

<ul class="list-group shadow-sm">
  <% @places.each do |place| %>
    <li class="list-group-item d-flex justify-content-between align-items-center">
      <div>
        <%= link_to place.name, place, class: "fw-semibold text-decoration-none" %>
        <div class="small text-muted"><%= place.address %></div>
      </div>
      <span class="badge bg-secondary"><%= place.category %></span>
    </li>
  <% end %>
</ul>