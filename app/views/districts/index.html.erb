<h1 class="h3 mb-4">Райони м. Івано-Франківськ</h1>
<div class="row row-cols-1 row-cols-md-3 g-4">
  <% @districts.each do |district| %>
    <div class="col">
      <div class="card h-100 shadow-sm border-0">
        <div class="card-body">
          <h2 class="h5 card-title"><%= link_to district.name, district, class: "text-decoration-none stretched-link" %></h2>
          <p class="text-muted small mb-2">Рівень безпеки маршрутів: <strong><%= district.route_safety_level %></strong></p>
          <span class="badge bg-primary-subtle text-primary-emphasis">Локацій у реєстрі: <%= district.places.size %></span>
        </div>
      </div>
    </div>
  <% end %>
</div>