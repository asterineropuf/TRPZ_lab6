<div id="<%= dom_id place %>">
  <div>
    <strong>Name:</strong>
    <%= place.name %>
  </div>

  <div>
    <strong>Category:</strong>
    <%= place.category %>
  </div>

  <div>
    <strong>Address:</strong>
    <%= place.address %>
  </div>

  <div>
    <strong>Latitude:</strong>
    <%= place.latitude %>
  </div>

  <div>
    <strong>Longitude:</strong>
    <%= place.longitude %>
  </div>

  <div>
    <strong>Has ramp:</strong>
    <%= place.has_ramp %>
  </div>

  <div>
    <strong>Has braille:</strong>
    <%= place.has_braille %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= place.description %>
  </div>

</div>
